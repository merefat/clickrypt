# Copy to apps/api/.env for local development
DATABASE_URL="postgresql://clickrypt:clickrypt_dev@localhost:5432/clickrypt?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4001
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
WEB_ORIGIN="http://localhost:3000"

# ── SMTP / Email ──────────────────────────────────────────────────────
# For local dev, MailHog captures emails at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT=1025
# For Gmail, use:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_SECURE="false"  (use STARTTLS on port 587)
#   SMTP_USER="your@gmail.com"
#   SMTP_PASS="your-app-password"  (Gmail requires an App Password, not your regular password)
# For port 465 (implicit SSL), set SMTP_SECURE="true"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Clickrypt <no-reply@clickrypt.local>"

# ── App URL ───────────────────────────────────────────────────────────
# Must be publicly accessible for email invite links to work
APP_URL="http://localhost:3000"
DEPLOYMENT_MODE="organization"

# ── Deployment (Vercel + Railway) ─────────────────────────────────────
# On Vercel, set these env vars so the web app can reach the deployed API:
#   API_URL              = https://your-api.up.railway.app  (no trailing slash, no /api/v1)
#   NEXT_PUBLIC_API_URL  = https://your-api.up.railway.app/api/v1  (full base URL for client)
# On Railway, set these env vars for the API service:
#   DATABASE_URL   = (Railway Postgres internal connection string)
#   REDIS_URL      = (Railway Redis internal connection string)
#   JWT_SECRET     = (strong secret, min 16 chars)
#   WEB_ORIGIN     = https://your-app.vercel.app  (comma-separated for multiple origins)
#   PORT           = (Railway sets this automatically)
