# Copy to apps/api/.env for local development
DATABASE_URL="postgresql://clickrypt:clickrypt_dev@localhost:5432/clickrypt?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4001
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
WEB_ORIGIN="https://your-app.vercel.app"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Clickrypt <no-reply@clickrypt.local>"
APP_URL="http://localhost:3000"
DEPLOYMENT_MODE="organization"
