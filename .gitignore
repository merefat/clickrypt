# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js Build Outputs
/.next/
/out/

# Production
/build

# Miscellaneous & System Files
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Files (Ignore local secrets, keep .env.example template)
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production
.env.production.local
!.env.example

# Vercel Deployment Cache
.vercel

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Runtime Database Storage
/data/db.json
