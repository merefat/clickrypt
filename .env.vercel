# ── VERCEL (Web App) Environment Variables ─────────────────────────────────────
# Set these in Vercel Project Settings → Environment Variables
# Or use: vercel env push .env.vercel

# Required: Your deployed Railway API URL (no trailing slash, no /api/v1)
API_URL=https://your-api.up.railway.app

# ── RAILWAY (API) Environment Variables ────────────────────────────────────────
# Set these in Railway Dashboard for your API service
# These are listed here for reference - Railway uses its own connection strings

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:port/database?schema=public

# Redis (Railway provides this automatically)
REDIS_URL=redis://host:port

# JWT Configuration
JWT_SECRET=change-me-to-a-strong-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# CORS / Origins
WEB_ORIGIN=https://your-app.vercel.app
PORT=4001

# App Configuration
DEPLOYMENT_MODE=organization
APP_URL=https://your-app.vercel.app

# ── OPTIONAL: Email Configuration (for SMTP/invitations) ─────────────────────
# Only set these if you want email functionality
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=ClickPass <no-reply@yourdomain.com>
